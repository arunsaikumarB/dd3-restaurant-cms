# =============================================================================
# Desi Dhamaka — environment variables
# Copy to .env.local for local development.
# Set in Netlify → Site configuration → Environment variables for deploys.
# =============================================================================

# Public site URL (no trailing slash)
# Demo/staging:  https://your-demo-name.netlify.app
# Production:    https://desidhamakanj.net/lawrenceville
VITE_SITE_URL=

# Supabase — Project URL (Settings → API)
VITE_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=

# Supabase — anon public key (safe for browser)
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY. Never commit. Never use in React or Netlify.
SUPABASE_SERVICE_ROLE_KEY=

# Serper.dev API key — SERVER ONLY (Netlify Functions).
# Used by netlify/functions/google-reviews-sync.mts to pull Google Maps
# reviews per location (see src/config/locations.ts googlePlaceId). Free plan:
# 100 searches/month, no card required. Never expose to the browser.
SERPER_API_KEY=

# Google Analytics 4 (Data API) — SERVER ONLY (Netlify Functions).
# Used by netlify/functions/analytics-ga4.mts. Never expose to the browser.
# GA4_PRIVATE_KEY: paste as ONE line with \n between PEM lines (not literal line breaks).
# Example: -----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Cheffy AI provider (client service layer — no API keys in the browser).
# gemini | openai | claude | mock
VITE_AI_PROVIDER=gemini

# Cheffy AI — SERVER ONLY (Netlify Function: ai-concierge).
# Gemini is the default provider for demo. Keys must never be exposed to React.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.4
GEMINI_TOP_P=0.95
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_STREAMING=true
CHEFFY_PROMPT_VERSION=1

# Optional OpenAI provider (AI_PROVIDER=openai, VITE_AI_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.4
OPENAI_MAX_OUTPUT_TOKENS=1024

# Optional Claude provider (AI_PROVIDER=claude).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# SMTP — SERVER ONLY (Netlify Functions). Used by
# netlify/functions/submit-enquiry.mts (via nodemailer) to email
# contact/catering enquiries. Example (IONOS): host smtp.ionos.com,
# port 465 (implicit TLS) or 587 (STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# "From" address — defaults to SMTP_USER if left blank.
SMTP_FROM=

# TEMPORARY shared test inbox for all 6 enquiry forms (3 locations x
# contact/catering). Replace with real per-form recipients in
# src/config/enquiryRecipients.ts when ready.
ENQUIRY_NOTIFY_EMAIL=

# Browser origins allowed to call public functions from another site.
# Comma-separated, no paths. Same-origin requests are always allowed.
# VITE_SITE_URL, and Netlify URL / DEPLOY_PRIME_URL, are added automatically.
# Example: https://desidhamakanj.net,https://www.desidhamakanj.net
ALLOWED_ORIGINS=

# Per-IP limits for public functions. Shared across instances after migration
# 038_function_rate_limits.sql is applied. Until then, each instance counts alone.
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_AI_CONCIERGE=60
RATE_LIMIT_SUBMIT_ENQUIRY=10
RATE_LIMIT_SEMANTIC_SEARCH=120

# Max JSON body size in bytes.
MAX_BODY_BYTES_AI_CONCIERGE=262144
MAX_BODY_BYTES_SUBMIT_ENQUIRY=32768
MAX_BODY_BYTES_SEMANTIC_SEARCH=16384
MAX_BODY_BYTES_SEMANTIC_INDEX=16384

# Outbound call timeouts (milliseconds). Model timeout covers Gemini, OpenAI,
# Anthropic, and semantic embeddings. It applies until response headers arrive
# so chat streaming can continue. SMTP timeout covers connect and send.
MODEL_TIMEOUT_MS=25000
SMTP_TIMEOUT_MS=20000
